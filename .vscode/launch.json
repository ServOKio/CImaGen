{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Flutter debug",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "flutterMode": "debug",
            // "env": {
            //     "NO_OPUS_OGG_LIBS": "1"
            // },
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Flutter test",
            "type": "dart",
            "request": "launch",
            "program": "tests/tests.dart",
            "flutterMode": "debug",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug native Windows",
            "preLaunchTask": "compile windows debug",
            "type": "cppvsdbg",
            "request": "launch",
            "args": [],
            "program": "${workspaceFolder}/build/windows/x64/runner/Debug/cimagen.exe",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug native Windows VERBOSE",
            "preLaunchTask": "compile windows debug verbose",
            "type": "cppvsdbg",
            "request": "launch",
            "args": [],
            "program": "${workspaceFolder}/build/windows/x64//runner/Debug/cimagen.exe",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Chrome wasm release",
            "type": "chrome",
            "preLaunchTask": "compile web wasm release",
            "request": "launch"
        }
    ]
}